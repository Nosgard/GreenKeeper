<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:GreenKeeper.Models.Enums"
                    xmlns:active="clr-namespace:GreenKeeper.ViewModels.CareStatuses.Active"
                    xmlns:passive="clr-namespace:GreenKeeper.ViewModels.CareStatuses.Passive">

    <!-- Icon and color of a card follow its care type -->
    <Style x:Key="CareIconBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0, 0, 12, 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Watering}">
                <Setter Property="Background" Value="#4accff" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Fertilizing}">
                <Setter Property="Background" Value="#ff695b" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Sunlight}">
                <Setter Property="Background" Value="#ffcc00" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CareIcon" TargetType="Image">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Watering}">
                <Setter Property="Source" Value="/Resources/Icons/Waterdrop.png" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Fertilizing}">
                <Setter Property="Source" Value="/Resources/Icons/Pill.png" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Sunlight}">
                <Setter Property="Source" Value="/Resources/Icons/Sun.png" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CareStatusCardTemplate">
        <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource ControlBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            Margin="0, 14, 0, 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon box -->
                <Border Grid.Column="0" Style="{StaticResource CareIconBox}">
                    <Image Style="{StaticResource CareIcon}" />
                </Border>

                <!-- Subtitle container -->
                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="16"
                       FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal">
                        <!-- Foreground belongs in the style, not on the element: a
                             local value would outrank the trigger below. -->
                        <TextBlock Text="{Binding StatusText}"
                           FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OverdueText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Buttons-->
                <!-- Will be filled via the implicit template of the actual type-->
                <ContentPresenter Grid.Column="3"
                                  Content="{Binding}"
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- DataTemplates to set the right buttons for each care status -->

    <!-- Button set: Watering -->
    <DataTemplate DataType="{x:Type active:WateringStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Complete"
                    Padding="10"
                    Margin="0, 0, 6, 0"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding IsCompletable}"/>
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Edit"
                    Padding="10"
                    Command="{Binding EditCommand}" />
        </StackPanel>
    </DataTemplate>

    <!-- Button set: Fertilizing -->
    <DataTemplate DataType="{x:Type active:FertilizingStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Complete"
                    Padding="10"
                    Margin="0, 0, 6, 0"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding IsCompletable}" />
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Edit"
                    Padding="10"
                    Margin="0, 0, 6, 0"
                    Command="{Binding EditCommand}" />
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Remove"
                    Padding="10"
                    Command="{Binding RemoveCommand}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Button set: Sunlight -->
    <DataTemplate DataType="{x:Type passive:SunlightStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Edit"
                    Padding="10"
                    Margin="0, 0, 6, 0"
                    Command="{Binding EditCommand}" />
            <Button Style="{StaticResource StatusCardActionButton}"
                    Content="Remove"
                    Padding="10"
                    Command="{Binding RemoveCommand}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
