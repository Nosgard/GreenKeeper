<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:GreenKeeper.Models.Enums"
                    xmlns:active="clr-namespace:GreenKeeper.ViewModels.CareStatuses.Active"
                    xmlns:passive="clr-namespace:GreenKeeper.ViewModels.CareStatuses.Passive">

    <!-- Icon and color of a card follow its care type -->
    <Style x:Key="CareIconBox" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0, 0, 12, 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Watering}">
                <Setter Property="Background" Value="{DynamicResource WateringIconFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Fertilizing}">
                <Setter Property="Background" Value="{DynamicResource FertilizingIconFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Sunlight}">
                <Setter Property="Background" Value="{DynamicResource SunlightIconFill}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The icon only repeats the card's title, so it is drawn as a shape, which a
         screen reader skips. -->
    <Style x:Key="CareIcon" TargetType="Rectangle">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Watering}">
                <Setter Property="Fill">
                    <Setter.Value>
                        <ImageBrush ImageSource="/Resources/Icons/Waterdrop.png" Stretch="Uniform" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Fertilizing}">
                <Setter Property="Fill">
                    <Setter.Value>
                        <ImageBrush ImageSource="/Resources/Icons/Pill.png" Stretch="Uniform" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Care}" Value="{x:Static enums:CareType.Sunlight}">
                <Setter Property="Fill">
                    <Setter.Value>
                        <ImageBrush ImageSource="/Resources/Icons/Sun.png" Stretch="Uniform" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Container of a card in the list: a screen reader names the card by its title
         rather than by the type of its ViewModel -->
    <Style x:Key="CareStatusCardContainer" TargetType="ContentPresenter">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    </Style>

    <!-- Buttons of a card. A screen reader names each one with its card ("Complete
         Watering"), since every card has an "Edit", and hears the status of the card,
         which otherwise comes before the button only when the whole card is read. -->
    <Style x:Key="CareStatusCardButton" TargetType="Button" BasedOn="{StaticResource StatusCardActionButton}">
        <Setter Property="Padding" Value="10" />
        <Setter Property="AutomationProperties.Name">
            <Setter.Value>
                <MultiBinding StringFormat="{}{0} {1}">
                    <Binding Path="Content" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Title" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding SpokenStatusText}" />
    </Style>

    <DataTemplate x:Key="CareStatusCardTemplate">
        <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource ControlBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            Margin="0, 14, 0, 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon box -->
                <Border Grid.Column="0" Style="{StaticResource CareIconBox}">
                    <Rectangle Style="{StaticResource CareIcon}" />
                </Border>

                <!-- Subtitle container; its margin keeps the text off the buttons
                     where the card gets narrow -->
                <StackPanel Grid.Column="1"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Center"
                            Margin="0, 0, 8, 0">
                    <TextBlock Text="{Binding Title}"
                       AutomationProperties.HeadingLevel="Level4"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="18"
                       FontWeight="SemiBold" />

                    <!-- Wraps where the buttons leave too little room for one line.
                         Foreground belongs in the style, not on the element: a
                         local value would outrank the trigger below. -->
                    <TextBlock Text="{Binding StatusText}"
                       AutomationProperties.Name="{Binding SpokenStatusText}"
                       FontSize="16"
                       TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OverdueText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Buttons-->
                <!-- Will be filled via the implicit template of the actual type-->
                <ContentPresenter Grid.Column="3"
                                  Content="{Binding}"
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- DataTemplates to set the right buttons for each care status -->

    <!-- Button set: Watering -->
    <DataTemplate DataType="{x:Type active:WateringStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Complete"
                    Margin="0, 0, 6, 0"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding IsCompletable}"/>
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Edit"
                    Command="{Binding EditCommand}" />
        </StackPanel>
    </DataTemplate>

    <!-- Button set: Fertilizing -->
    <DataTemplate DataType="{x:Type active:FertilizingStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Complete"
                    Margin="0, 0, 6, 0"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding IsCompletable}" />
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Edit"
                    Margin="0, 0, 6, 0"
                    Command="{Binding EditCommand}" />
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Button set: Sunlight -->
    <DataTemplate DataType="{x:Type passive:SunlightStatusViewModel}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Edit"
                    Margin="0, 0, 6, 0"
                    Command="{Binding EditCommand}" />
            <Button Style="{StaticResource CareStatusCardButton}"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
