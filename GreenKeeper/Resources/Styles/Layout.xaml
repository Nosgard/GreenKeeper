<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:layout="clr-namespace:GreenKeeper.Layout">
    <!-- Layout tokens: how the UI adapts to the window and the screen. Sizes inside the
         window are in units of the design (scale 1). The smallest window and the reference
         screen are not. -->

    <!-- Smallest window. These two values are its outer size with the frame, not design
         units. At the lowest scale (0.857, see WindowScale) the inside holds about 800 x 540
         design units, enough for three cards and their buttons without scrolling in a
         Release build, where no debug panel takes room -->
    <sys:Double x:Key="WindowMinWidth">700</sys:Double>
    <sys:Double x:Key="WindowMinHeight">500</sys:Double>

    <!-- The screen the design size in MainWindow.xaml is meant for. Without a stored
         window placement, the window opens larger on a work area larger on both sides, by
         the ratio of the tighter side (see StartSize). -->
    <Size x:Key="ReferenceScreenSize">1920,1080</Size>

    <!-- How the UI follows the size of the window (see FluidScale). The shrink rate is
         high enough to reach the minimum at the smallest window, and that scale leaves
         the status texts room next to their buttons. The minimum keeps the smallest text
         of a Release build, 14, at 12 px. The maximum is the scale of a window twice the design size. -->
    <layout:FluidScale x:Key="WindowScale"
                       Minimum="0.857"
                       Maximum="1.5"
                       GrowRate="0.5"
                       ShrinkRate="0.75" />

    <!-- Sidebar: keeps its share of the width within these limits, never narrower than designed -->
    <sys:Double x:Key="SidebarMinWidth">250</sys:Double>
    <sys:Double x:Key="SidebarMaxWidth">320</sys:Double>

    <!-- Dashboard: the content grows up to this width and stays centered beyond it. The
         limit keeps a card's text and its buttons close together. -->
    <sys:Double x:Key="ContentMaxWidth">760</sys:Double>

    <!-- Tooltip: a longer text wraps instead of running across the screen -->
    <sys:Double x:Key="ToolTipMaxWidth">360</sys:Double>
</ResourceDictionary>
