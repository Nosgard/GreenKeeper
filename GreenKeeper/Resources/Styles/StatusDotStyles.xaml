<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:GreenKeeper.Models.Enums">
    <!-- Status dot of a plant entry, drawn for a PlantStatus. The state shows three
         ways, so nobody has to tell red, yellow and green apart: color, the sign inside
         (check, clock hands, exclamation mark) and the tooltip. The outline in the text
         color keeps the dot visible on every background of both themes, where the fills
         alone do not reach a contrast of 3:1. Drawn in a box of 20 x 20. It has no
         automation element; the entry's name carries the state for screen readers. -->

    <!-- The same fills in both themes; the outline separates them from either
         background. The sign is dark on the light fills and white on the red one. -->
    <SolidColorBrush x:Key="StatusUpToDateFill" Color="#3DBE4A" />
    <SolidColorBrush x:Key="StatusDueTodayFill" Color="#F6C21A" />
    <SolidColorBrush x:Key="StatusOverdueFill" Color="#D92D20" />
    <SolidColorBrush x:Key="StatusSignOnLightFill" Color="#1C1E22" />
    <SolidColorBrush x:Key="StatusSignOnDarkFill" Color="#FFFFFF" />

    <DataTemplate x:Key="PlantStatusDot">
        <Grid x:Name="dot"
              Width="20"
              Height="20"
              Background="Transparent"
              ToolTip="Up to date">
            <Ellipse x:Name="circle"
                     Margin="1"
                     Fill="{StaticResource StatusUpToDateFill}"
                     Stroke="{DynamicResource PrimaryText}"
                     StrokeThickness="1.5" />

            <!-- Up to date: a check -->
            <Path x:Name="sign"
                  Data="M 6,10.4 L 8.9,13.2 L 14,7.4"
                  Stroke="{StaticResource StatusSignOnLightFill}"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Grid>

        <DataTemplate.Triggers>
            <!-- Due today: clock hands -->
            <DataTrigger Binding="{Binding}" Value="{x:Static enums:PlantStatus.DueToday}">
                <Setter TargetName="circle" Property="Fill" Value="{StaticResource StatusDueTodayFill}" />
                <Setter TargetName="sign" Property="Data" Value="M 10,5.6 L 10,10.2 L 13.2,12.2" />
                <Setter TargetName="dot" Property="ToolTip" Value="Due today" />
            </DataTrigger>

            <!-- Overdue: an exclamation mark -->
            <DataTrigger Binding="{Binding}" Value="{x:Static enums:PlantStatus.Overdue}">
                <Setter TargetName="circle" Property="Fill" Value="{StaticResource StatusOverdueFill}" />
                <Setter TargetName="sign" Property="Data" Value="M 10,5.4 L 10,10.8 M 10,14.2 L 10,14.3" />
                <Setter TargetName="sign" Property="Stroke" Value="{StaticResource StatusSignOnDarkFill}" />
                <Setter TargetName="sign" Property="StrokeThickness" Value="2.2" />
                <Setter TargetName="dot" Property="ToolTip" Value="Overdue" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
