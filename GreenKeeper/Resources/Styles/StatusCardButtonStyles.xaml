<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Status card action button: the small button with its own, lighter disabled look.
         Style triggers outrank the template triggers of BigButton, so only the disabled
         colors are overridden here and the template stays shared. -->
    <Style x:Key="StatusCardActionButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Width" Value="85" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource StatusButtonDisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource StatusButtonDisabledForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
