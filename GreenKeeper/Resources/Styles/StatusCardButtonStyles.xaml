<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The small button with its own, lighter disabled look. It sets the colors in its
         style and keeps sharing the template of BigButton. -->
    <Style x:Key="StatusCardActionButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Width" Value="85" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource StatusButtonDisabledBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource StatusButtonDisabledForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
