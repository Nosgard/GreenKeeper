<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1A1C22" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#23252B" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#3B3B3D" />
    <SolidColorBrush x:Key="SearchBarBackground" Color="#2E313A" />

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectedBackground" Color="#434651" />
    <SolidColorBrush x:Key="SelectedBorder" Color="#6C6F7A" />

    <!-- Keyboard focus: the ring around the control Tab has reached, in the color of
         the primary text, the strongest contrast to every background of the theme. -->
    <SolidColorBrush x:Key="FocusBorder" Color="#F0F0EE" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#494B54" />
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#575964" />
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#21232B" />
    <SolidColorBrush x:Key="ButtonDisabledBorder" Color="#40424B" />
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#727270" />

    <!-- Status card buttons -->
    <SolidColorBrush x:Key="StatusButtonDisabledBorder" Color="#4A4C55" />
    <SolidColorBrush x:Key="StatusButtonDisabledForeground" Color="#8A8D92" />

    <!-- Borders, separators, scrollbar. ControlBorder is the soft frame of buttons,
         cards and popups. ControlOutline marks a control that stands on its own (text
         boxes, drop-downs, the scroll bar thumb) and keeps 3:1 against every
         background it sits on. -->
    <SolidColorBrush x:Key="ControlBorder" Color="#5B5E69" />
    <SolidColorBrush x:Key="ControlOutline" Color="#83868F" />
    <SolidColorBrush x:Key="DividerBrush" Color="#4B4D55" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#626570" />
    <SolidColorBrush x:Key="ScrollBarThumbPressed" Color="#9A9DA8" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryText" Color="#F0F0EE" />
    <SolidColorBrush x:Key="SecondaryText" Color="#B1B1AD" />
    <SolidColorBrush x:Key="MutedText" Color="#9A9A96" />
    <SolidColorBrush x:Key="SearchText" Color="#C8C8C4" />

    <!-- Icon boxes of the status cards, one hue per care type, toned down for the dark surface -->
    <SolidColorBrush x:Key="WateringIconFill" Color="#3FA8D6" />
    <SolidColorBrush x:Key="FertilizingIconFill" Color="#D9655A" />
    <SolidColorBrush x:Key="SunlightIconFill" Color="#D9B021" />

    <!-- Overdue status text -->
    <SolidColorBrush x:Key="OverdueText" Color="#F89696" />

    <!-- Debug panel (DEBUG builds only) -->
    <SolidColorBrush x:Key="DangerBackground" Color="#322221" />
    <SolidColorBrush x:Key="DangerBorder" Color="#9A6362" />
    <SolidColorBrush x:Key="DangerForeground" Color="#D08080" />
</ResourceDictionary>