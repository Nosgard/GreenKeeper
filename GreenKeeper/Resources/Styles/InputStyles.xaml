<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:GreenKeeper.ViewModels.Base">
    <!-- Shared building blocks of the dialogs and wizard steps -->

    <!-- Heading of a dialog or wizard step -->
    <Style x:Key="DialogHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0, 0, 0, 12" />
    </Style>

    <!-- Hint below an input field, e.g. the limit or the remaining characters -->
    <Style x:Key="InputHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0, 6, 0, 0" />
    </Style>

    <!-- Text input on a themed surface -->
    <Style x:Key="ThemedTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Save / Cancel / Next / Back and the dashboard buttons -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource MediumButton}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Amount + time unit, bound to an AmountAndUnitInputViewModel -->
    <DataTemplate x:Key="AmountAndUnitInput">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource ThemedTextBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" />

                <ComboBox Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{x:Static base:AmountAndUnitInputViewModel.AvailableUnits}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedUnit}"
                          Width="140"
                          Margin="10, 0, 0, 0"
                          Padding="8" />
            </StackPanel>

            <TextBlock Style="{StaticResource InputHint}"
                       Text="{Binding MaxAmount, StringFormat='max. {0}'}" />
        </StackPanel>
    </DataTemplate>

    <!-- Hours + period, bound to a HoursPerPeriodInputViewModel -->
    <DataTemplate x:Key="HoursPerPeriodInput">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource ThemedTextBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" />

                <TextBlock Text="Hours"
                           Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="8, 0, 0, 0" />

                <ComboBox Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{x:Static base:HoursPerPeriodInputViewModel.AvailablePeriods}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedPeriod}"
                          Width="140"
                          Margin="10, 0, 0, 0"
                          Padding="8" />
            </StackPanel>

            <TextBlock Style="{StaticResource InputHint}"
                       Text="{Binding MaxAmount, StringFormat='max. {0}'}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
