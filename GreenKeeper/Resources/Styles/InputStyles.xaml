<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="clr-namespace:GreenKeeper.ViewModels.Base"
                    xmlns:views="clr-namespace:GreenKeeper.Views">
    <!-- Shared building blocks of the dialogs and wizard steps -->

    <!-- Heading of a dialog or wizard step. It wraps instead of being cut off, since
         the Notes window shows the plant name in it. -->
    <Style x:Key="DialogHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0, 0, 0, 12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>

    <!-- Hint below an input field, e.g. the limit or the remaining characters -->
    <Style x:Key="InputHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0, 6, 0, 0" />
    </Style>

    <!-- The limit below an amount field. Once the amount exceeds it, it turns into
         the reason ("Too large, max. 365") in the overdue color, and a screen reader
         hears it right then, while the focus stays in the field. -->
    <Style x:Key="AmountLimitHint" TargetType="TextBlock" BasedOn="{StaticResource InputHint}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAmountTooLarge}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OverdueText}" />
                <Setter Property="views:Announcer.Message" Value="{Binding AmountHint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Text input on a themed surface -->
    <Style x:Key="ThemedTextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- The field of an amount input. Its heading lies outside the input templates
         below, so the hosting ContentControl carries the field's name and whether it is
         required as AutomationProperties, and the field takes them over. -->
    <Style x:Key="AmountTextBox" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
        <Setter Property="Width" Value="80" />
        <Setter Property="AutomationProperties.Name" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentControl}}" />
        <Setter Property="AutomationProperties.IsRequiredForForm" Value="{Binding (AutomationProperties.IsRequiredForForm), RelativeSource={RelativeSource AncestorType=ContentControl}}" />
    </Style>

    <!-- Save / Cancel / Next / Back and the dashboard buttons -->
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource MediumButton}">
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Amount and time unit, bound to an AmountAndUnitInputViewModel. The field takes
         a whole number with no more digits than fit into it, so its content stays
         visible. The hint below the field is its description. -->
    <DataTemplate x:Key="AmountAndUnitInput">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource AmountTextBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         views:WholeNumberInput.MaxDigits="{x:Static base:AmountAndUnitInputViewModel.MaxAmountLength}"
                         AutomationProperties.HelpText="{Binding Text, ElementName=limitHint}" />

                <ComboBox Style="{StaticResource ThemedComboBox}"
                          AutomationProperties.Name="Time unit"
                          ItemsSource="{x:Static base:AmountAndUnitInputViewModel.AvailableUnits}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedUnit}"
                          Width="140"
                          Margin="10, 0, 0, 0"
                          Padding="8" />
            </StackPanel>

            <TextBlock x:Name="limitHint"
                       Style="{StaticResource AmountLimitHint}"
                       Text="{Binding AmountHint}" />
        </StackPanel>
    </DataTemplate>

    <!-- Hours and period, bound to a HoursPerPeriodInputViewModel. The field is limited
         and named the same way; its description adds the unit next to it. -->
    <DataTemplate x:Key="HoursPerPeriodInput">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource AmountTextBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         views:WholeNumberInput.MaxDigits="{x:Static base:HoursPerPeriodInputViewModel.MaxAmountLength}">
                    <AutomationProperties.HelpText>
                        <MultiBinding StringFormat="{}{0}, {1}">
                            <Binding Path="Text" ElementName="unitLabel" />
                            <Binding Path="Text" ElementName="limitHint" />
                        </MultiBinding>
                    </AutomationProperties.HelpText>
                </TextBox>

                <TextBlock x:Name="unitLabel"
                           Text="Hours"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="8, 0, 0, 0" />

                <ComboBox Style="{StaticResource ThemedComboBox}"
                          AutomationProperties.Name="Period"
                          ItemsSource="{x:Static base:HoursPerPeriodInputViewModel.AvailablePeriods}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedPeriod}"
                          Width="140"
                          Margin="10, 0, 0, 0"
                          Padding="8" />
            </StackPanel>

            <TextBlock x:Name="limitHint"
                       Style="{StaticResource AmountLimitHint}"
                       Text="{Binding AmountHint}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
