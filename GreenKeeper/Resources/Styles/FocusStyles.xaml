<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views">
    <!-- The ring around the control with the keyboard focus replaces the dotted focus
         line, which disappears on the dark theme. At 3 px it stays over 2 screen pixels
         wide at the smallest window scale. Its radius follows the rounded controls
         (4 to 6) plus the 5 px it reaches beyond them. FocusCue hides the ring in a window
         opened with a click, and in a window that comes back to the front after the mouse
         was used last in it, until a key is pressed there (see FocusCueState). A window
         opened with the keyboard shows the ring at once. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Ring"
                            Margin="-5"
                            BorderThickness="3"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource FocusBorder}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="views:FocusCue.IsHidden" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same ring inside the control, for entries of a list, a drop-down or the
         context menu: they fill the width of their list, which cuts off anything drawn
         outside it. The vertical margin aligns the ring with the background of a plant
         entry. -->
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Ring"
                            Margin="0, 2"
                            BorderThickness="3"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource FocusBorder}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="views:FocusCue.IsHidden" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
