<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The ring around the control with the keyboard focus. As a FocusVisualStyle WPF
         draws it only after the control was reached with the keyboard, not after a
         click. It replaces the focus visual of Windows, a dotted line of 1 px in the
         system text color, which the themes cannot reach and which disappears on the
         dark one. 2 px away from the control and 3 px wide: the ring is drawn at the
         scale of the window, and at the smallest scale (0.78) that still leaves 2 screen
         pixels on every side. Rounded like the controls (4 to 6) plus gap and width. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-5"
                            BorderThickness="3"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource FocusBorder}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same ring inside the control, for entries of a list or a drop-down: they
         fill the width of their list, which cuts off anything drawn outside of it. The
         vertical margin aligns the ring with the background of a plant entry, 2 px
         smaller than the entry, and keeps it off the neighbors. -->
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="0, 2"
                            BorderThickness="3"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource FocusBorder}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
