<views:DialogWindow x:Class="GreenKeeper.Views.CareStatuses.EditOption.EditScheduleView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:editSchedule="clr-namespace:GreenKeeper.ViewModels.CareStatuses.EditOption"
                    mc:Ignorable="d"
                    Icon="{StaticResource AppIcon}"
                    Title="Edit Schedule" Height="300" Width="450"
                    Background="{DynamicResource WindowBackground}"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize">
    <Window.Resources>
        <!-- Watering / Fertilizing -->
        <DataTemplate DataType="{x:Type editSchedule:EditActiveScheduleViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="{Binding Title, StringFormat='Edit period for {0}'}" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AmountAndUnitInput}"
                                Focusable="False" />

                <TextBlock Text="{Binding PreviewText}"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="13"
                           Margin="0, 10, 0, 0" />
            </StackPanel>
        </DataTemplate>

        <!-- Sunlight -->
        <DataTemplate DataType="{x:Type editSchedule:EditSunlightViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Edit sunlight requirement" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource HoursPerPeriodInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding CurrentStep}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 12, 0, 0">

            <Button Style="{StaticResource DialogButton}"
                    Content="Save"
                    Command="{Binding SaveCommand}" />

            <Button Style="{StaticResource DialogButton}"
                    Content="Cancel"
                    Margin="10, 0, 0, 0"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
