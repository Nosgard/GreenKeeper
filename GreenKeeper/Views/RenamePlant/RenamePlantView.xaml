<Window x:Class="GreenKeeper.Views.RenamePlant.RenamePlantView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenKeeper.Views.RenamePlant"
        mc:Ignorable="d"
        Icon="{StaticResource AppIcon}"
        Title="Rename Plant"
        Height="250"
        Width="450"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Enter a new name for the plant"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0, 0, 0, 12" />

                <TextBox x:Name="NameTextBox"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="50"
                         Background="{DynamicResource SurfaceBackground}"
                         Foreground="{DynamicResource PrimaryText}"
                         CaretBrush="{DynamicResource PrimaryText}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource ControlBorder}"
                         Padding="8"
                         FontSize="14" />

                <TextBlock Text="{Binding CharactersRemaining, StringFormat='{}{0} characters remaining'}"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="12"
                           Margin="0, 6, 0, 0" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0, 12, 0, 0">

                <Button Style="{StaticResource MediumButton}"
                    Content="Save"
                    Padding="10"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />

                <Button Style="{StaticResource MediumButton}"
                    Content="Cancel"
                    Margin="10, 0, 0, 0"
                    Padding="10"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
