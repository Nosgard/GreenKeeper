<views:DialogWindow x:Class="GreenKeeper.Views.RenamePlant.RenamePlantView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:GreenKeeper.Views.RenamePlant"
                    xmlns:models="clr-namespace:GreenKeeper.Models"
                    mc:Ignorable="d"
                    Icon="{StaticResource AppIcon}"
                    Title="Rename Plant"
                    Height="250"
                    Width="450"
                    Background="{DynamicResource WindowBackground}"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource DialogHeading}"
                       Text="Enter a new name for the plant" />

            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource ThemedTextBox}"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{x:Static models:Plant.MaxNameLength}" />

            <TextBlock Style="{StaticResource InputHint}"
                       Text="{Binding CharactersRemaining, StringFormat='{}{0} characters remaining'}" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 12, 0, 0">

            <Button Style="{StaticResource DialogButton}"
                    Content="Save"
                    IsDefault="True"
                    Command="{Binding SaveCommand}" />

            <Button Style="{StaticResource DialogButton}"
                    Content="Cancel"
                    Margin="10, 0, 0, 0"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
