<views:DialogWindow x:Class="GreenKeeper.Views.Messages.MessageView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    Icon="{StaticResource AppIcon}"
                    Height="200"
                    Width="450"
                    Background="{DynamicResource WindowBackground}"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize"
                    AutomationProperties.HelpText="{Binding Message}">
    <!-- The message is the description of the window and of its buttons, so a screen
         reader reads it when the window opens with the focus on one of them. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The question or the notice; a long text wraps, and the window grows with it -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   Foreground="{DynamicResource PrimaryText}"
                   FontSize="16"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 12, 0, 0">

            <!-- Yes for a question, OK for a notice. A notice has no second button,
                 so Esc acknowledges it as well. -->
            <Button x:Name="ConfirmButton"
                    Content="{Binding ConfirmLabel}"
                    AutomationProperties.HelpText="{Binding Message}"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuestion}" Value="False">
                                <Setter Property="IsCancel" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Only a question can be declined, with this button and not with Esc, since
                 "No" can be the answer that discards something. -->
            <Button x:Name="DeclineButton"
                    Style="{StaticResource DialogButton}"
                    Content="No"
                    AutomationProperties.HelpText="{Binding Message}"
                    Margin="10, 0, 0, 0"
                    Command="{Binding DeclineCommand}"
                    Visibility="{Binding IsQuestion, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
