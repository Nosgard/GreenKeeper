<views:DialogWindow x:Class="GreenKeeper.Views.Wizards.AddScheduleWizard.AddScheduleWizardView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:steps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddScheduleWizard.Steps"
                    xmlns:activeSteps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddScheduleWizard.Steps.Active"
                    xmlns:passiveSteps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddScheduleWizard.Steps.Passive"
                    mc:Ignorable="d"
                    Icon="{StaticResource AppIcon}"
                    Title="Add Schedule" Height="300" Width="450"
                    Background="{DynamicResource WindowBackground}"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize">
    <Window.Resources>
        <!-- Step 1: Selection of CareType -->
        <DataTemplate DataType="{x:Type steps:CareTypeSelectionStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="What would you like to add?" />

                <ComboBox Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{x:Static steps:CareTypeSelectionStepViewModel.AvailableCareTypes}"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding SelectedCareType}"
                          Width="140"
                          HorizontalAlignment="Left"
                          Padding="8" />
            </StackPanel>
        </DataTemplate>

        <!-- Step 2 (Watering/Fertilizing): Value + Time Unit -->
        <DataTemplate DataType="{x:Type activeSteps:ScheduleActiveStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="{Binding Title, StringFormat='Enter the period for {0}'}" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AmountAndUnitInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Step 2 (Sunlight): Hours + Period -->
        <DataTemplate DataType="{x:Type passiveSteps:ScheduleSunlightStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Enter the amount of sunlight" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource HoursPerPeriodInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding CurrentStep}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 12, 0, 0">

            <Button Style="{StaticResource DialogButton}"
                    Content="Back"
                    Command="{Binding BackCommand}" />

            <Button Style="{StaticResource DialogButton}"
                    Content="{Binding CurrentStep.NextButtonLabel}"
                    Margin="10, 0, 0, 0"
                    IsDefault="True"
                    Command="{Binding NextCommand}" />

            <Button Style="{StaticResource DialogButton}"
                    Content="Cancel"
                    Margin="10, 0, 0, 0"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
