<views:DialogWindow x:Class="GreenKeeper.Views.Wizards.AddPlantWizard.AddPlantWizardView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:GreenKeeper.Views"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:models="clr-namespace:GreenKeeper.Models"
                    xmlns:steps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddPlantWizard.Steps"
                    xmlns:activeSteps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddPlantWizard.Steps.Active"
                    xmlns:passiveSteps="clr-namespace:GreenKeeper.ViewModels.Wizards.AddPlantWizard.Steps.Passive"
                    mc:Ignorable="d"
                    Icon="{StaticResource AppIcon}"
                    Title="Add Plant" Height="330" Width="450"
                    Background="{DynamicResource WindowBackground}"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize">

    <Window.Resources>

        <!-- Plant Name Step -->
        <DataTemplate DataType="{x:Type steps:PlantNameStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Enter a name for the plant" />

                <TextBox Style="{StaticResource ThemedTextBox}"
                         Text="{Binding PlantName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="{x:Static models:Plant.MaxNameLength}" />

                <TextBlock Style="{StaticResource InputHint}"
                           Text="{Binding CharactersRemaining, StringFormat='{}{0} characters remaining'}" />
            </StackPanel>
        </DataTemplate>

        <!-- Watering Step -->
        <DataTemplate DataType="{x:Type activeSteps:WateringStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="* Enter the period for watering" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AmountAndUnitInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Fertilizing Step -->
        <DataTemplate DataType="{x:Type activeSteps:FertilizingStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Enter the period for fertilizing (optional)" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AmountAndUnitInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Sunlight Step -->
        <DataTemplate DataType="{x:Type passiveSteps:SunlightStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Enter the amount of sunlight (optional)" />

                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource HoursPerPeriodInput}"
                                Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Summary Step -->
        <DataTemplate DataType="{x:Type steps:SummaryStepViewModel}">
            <StackPanel Margin="20">
                <TextBlock Style="{StaticResource DialogHeading}"
                           Text="Summary" />

                <!-- Plant Name Line -->
                <TextBlock Text="{Binding PlantName}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="14"
                           Margin="0, 0, 0, 6" />

                <!-- Watering Line -->
                <TextBlock Text="{Binding Watering, StringFormat='Watering: {0}'}"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"
                           Margin="0, 0, 0, 6" />

                <!-- Fertilizing Line -->
                <TextBlock Text="{Binding Fertilizing, StringFormat='Fertilizing: {0}'}"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"
                           Margin="0, 0, 0, 6"
                           Visibility="{Binding HasFertilizing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Sunlight Line -->
                <TextBlock Text="{Binding Sunlight, StringFormat='Sunlight: {0}'}"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"
                           Margin="0, 0, 0, 6"
                           Visibility="{Binding HasSunlight, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Button Section -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding CurrentStep}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 12, 0, 0">

            <!-- Back -->
            <Button Style="{StaticResource DialogButton}"
                    Content="Back"
                    Margin="0, 0, 10, 0"
                    Command="{Binding BackCommand}" />

            <!-- Next -->
            <Button Style="{StaticResource DialogButton}"
                    Content="{Binding CurrentStep.NextButtonLabel}"
                    IsDefault="True"
                    Command="{Binding NextCommand}" />

            <!-- Cancel -->
            <Button Style="{StaticResource DialogButton}"
                    Content="Cancel"
                    Margin="10, 0, 0, 0"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
