<Window x:Class="GreenKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenKeeper"
        xmlns:views="clr-namespace:GreenKeeper.Views"
        mc:Ignorable="d"
        Icon="{StaticResource AppIcon}"
        Title="GreenKeeper"
        MinHeight="{StaticResource WindowMinHeight}"
        MinWidth="{StaticResource WindowMinWidth}"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <!-- Width and Height above are the design size, where the UI is drawn at scale 1
         (InitializeResponsiveSize in MainWindow.xaml.cs) -->

    <Grid Background="{DynamicResource WindowBackground}">
        <!-- Sidebar and dashboard share the width as they do at the design size, where 250
             and 634 fill the space inside the window frame. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250*"
                              MinWidth="{StaticResource SidebarMinWidth}"
                              MaxWidth="{StaticResource SidebarMaxWidth}" />
            <ColumnDefinition Width="634*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar. F6 and Shift+F6 switch between it and the dashboard (FocusRegions). -->
        <views:RegionGrid x:Name="Sidebar"
                          AutomationProperties.Name="Sidebar"
                          AutomationProperties.AcceleratorKey="F6"
                          Background="{DynamicResource SidebarBackground}"
                          Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16, 20, 16, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- One step smaller than the plant name in the dashboard, which is the main
                     title. The top margin puts both on one baseline. -->
                <TextBlock Grid.Column="0"
                           AutomationProperties.HeadingLevel="Level1"
                           Text="My Plants"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0, 4, 0, 0" />

                <!-- Theme toggle. Its label changes with every click, so it goes through
                     AccessibleName. The top margin centers the icon on the capital letters of
                     the heading and gives the row a whole-pixel height, which keeps the edges
                     of the search box below sharp. -->
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        views:AccessibleName.Text="{Binding Theme.ToggleLabel}"
                        ToolTip="{Binding Theme.ToggleLabel}"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        Padding="4"
                        Margin="0, 6, 0, 0"
                        Command="{Binding Theme.ToggleCommand}">
                    <!-- The PNG supplies only the shape; the color comes from PrimaryText, so
                         the icon fades along with a theme change. -->
                    <Rectangle Width="24"
                               Height="24"
                               Fill="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Theme.IsDarkTheme, Converter={StaticResource ThemeToggleIconConverter}}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </Grid>

            <!-- Search bar -->
            <Border Grid.Row="1"
                    Margin="10, 10, 10, 10"
                    Background="{DynamicResource SearchBarBackground}"
                    BorderBrush="{DynamicResource ControlOutline}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="1"
                             x:Name="SearchTextBox"
                             AutomationProperties.Name="Search plants"
                             FocusVisualStyle="{StaticResource FocusRing}"
                             Text="{Binding PlantList.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource SearchText}"
                             CaretBrush="{DynamicResource SearchText}"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="10, 8, 10, 8" />
                    <TextBlock Grid.Column="1"
                               Text="Search..."
                               Foreground="{DynamicResource MutedText}"
                               FontSize="14"
                               Margin="10, 0, 0, 0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchTextBox}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ListView Grid.Row="2"
                      x:Name="PlantList"
                      AutomationProperties.Name="Plants"
                      FocusVisualStyle="{StaticResource FocusRing}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="6, 0, 6, 0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding PlantList.Plants}"
                      SelectedItem="{Binding PlantList.SelectedPlant, Mode=TwoWay}"
                      SelectionChanged="PlantList_SelectionChanged">
                <ListView.Resources>
                    <!-- Context menu of a plant entry. It sits on the entry, which takes the
                         focus, so the menu key and Shift+F10 open the menu of the focused entry. -->
                    <ContextMenu x:Key="PlantContextMenu"
                                 x:Shared="False"
                                 Style="{StaticResource ThemedContextMenu}">
                        <MenuItem Header="Rename..."
                                  Style="{StaticResource ThemedMenuItem}"
                                  Command="{Binding PlacementTarget.Tag.PlantList.RenamePlantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <!-- The spoken name, like "Aloe Vera, overdue". The list sets it when it
                             builds an entry, and a changed name or state shows only in a rebuilt
                             entry, so a screen reader hears no change on an existing one. -->
                        <Setter Property="views:AccessibleName.Text" Value="{Binding Converter={StaticResource PlantAccessibleNameConverter}}" />
                        <EventSetter Event="KeyDown" Handler="PlantEntry_KeyDown" />
                        <!-- The context menu cannot find the window, so it reaches the
                             window's ViewModel through PlacementTarget.Tag -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource PlantContextMenu}" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            Margin="0, 2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource EntryHoverBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedBackground}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Status dot. A screen reader skips it, so the entry's name carries
                                 its state. -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{Binding Converter={StaticResource PlantStatusDotConverter}}"
                                              ContentTemplate="{StaticResource PlantStatusDot}"
                                              VerticalAlignment="Center"
                                              Margin="0, 0, 4, 0" />

                            <!-- VerticalAlignment="Center" leaves the name a little low in its
                                 entry. The margin lifts it by 1.5 and keeps the entry's height. -->
                            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="24"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="0, -1.5, 0, 1.5"
                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Says why the list is empty. The text sits in the style so the trigger below
                 can change it. -->
            <TextBlock Grid.Row="2"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="16, 8, 16, 0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- A search found no plant; the same words PlantListViewModel announces -->
                        <Setter Property="Text" Value="No plants found" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=PlantList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Without a search, the list is empty because no plant was added yet -->
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Text" Value="No plants yet" />
                            </DataTrigger>
                            <!-- At every start the list is empty for a moment, until the plants are loaded -->
                            <DataTrigger Binding="{Binding PlantList.HasLoadedPlants}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Row="3"
                    Style="{StaticResource DialogButton}"
                    Margin="10, 8, 10, 12"
                    Padding="0, 10"
                    Content="+  Add Plant"
                    AutomationProperties.Name="Add Plant"
                    Command="{Binding PlantList.AddPlantCommand}"/>
        </views:RegionGrid>

        <views:RegionGrid x:Name="Dashboard"
                          AutomationProperties.Name="Dashboard"
                          AutomationProperties.AcceleratorKey="F6"
                          Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Navigation -->
            <Grid Grid.Row="0"
                  VerticalAlignment="Center"
                  Margin="16, 20, 16, 12"
                  MaxWidth="{StaticResource ContentMaxWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           AutomationProperties.HeadingLevel="Level2"
                           VerticalAlignment="Top"
                           Text="{Binding PlantList.SelectedPlant.Name}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PlantList.SelectedPlant.Name}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}"
                            Content="+  Add Schedule"
                            AutomationProperties.Name="Add Schedule"
                            Command="{Binding Dashboard.AddScheduleCommand}" />

                    <Button Style="{StaticResource DialogButton}"
                            Margin="10, 0, 0, 0"
                            Content="-  Delete Plant"
                            AutomationProperties.Name="Delete Plant"
                            Command="{Binding Dashboard.DeletePlantCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" />

            <!-- Status: scrolls as soon as the cards do not fit above the footer -->
            <ScrollViewer x:Name="StatusScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <StackPanel x:Name="StatusPanel"
                            Margin="16, 0, 16, 12"
                            MaxWidth="{StaticResource ContentMaxWidth}"
                            RequestBringIntoView="StatusPanel_RequestBringIntoView">
                    <TextBlock x:Name="StatusHeading"
                               AutomationProperties.HeadingLevel="Level3"
                               Text="Status"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Visibility="{Binding Dashboard.IsPlantSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Status Cards (Watering, Fertilizing, Sunlight) -->
                    <ItemsControl x:Name="CareStatusList"
                                  ItemsSource="{Binding Dashboard.CareStatuses}"
                                  ItemTemplate="{StaticResource CareStatusCardTemplate}"
                                  ItemContainerStyle="{StaticResource CareStatusCardContainer}"
                                  AutomationProperties.Name="{Binding Text, ElementName=StatusHeading}"
                                  Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Tells what to do while no plant is selected. F6 from the sidebar reads it out
                 when the dashboard has nothing to focus (see FocusRegions). The text sits in
                 the style so the trigger below can change it. -->
            <TextBlock x:Name="EmptyDashboardHint"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedText}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16, 0, 16, 0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Select a plant or add a new one" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dashboard.IsPlantSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Nothing to select yet, once the plants have loaded -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PlantList.Plants.Count}" Value="0" />
                                    <Condition Binding="{Binding PlantList.HasLoadedPlants}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="Add your first plant to get started" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Footer: stays in view below the cards -->
            <Grid Grid.Row="3"
                  Margin="16, 0, 16, 0"
                  MaxWidth="{StaticResource ContentMaxWidth}">
                <Button Style="{StaticResource DialogButton}"
                        Content="View Notes"
                        Margin="0, 0, 0, 16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Command="{Binding Dashboard.OpenNotesCommand}"/>

                <!-- Debug section -->
                <Border Background="{DynamicResource DangerBackground}"
                        BorderBrush="{DynamicResource DangerBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0, 0, 0, 80"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SimulateLabel"
                                   Text="DEBUG: Simulate"
                                   Foreground="{DynamicResource DangerForeground}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0, 0, 8, 0" />

                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 AutomationProperties.Name="{Binding Text, ElementName=SimulateLabel}"
                                 Text="{Binding TimeSimulation.AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="40"
                                 Padding="4"
                                 FontSize="12"
                                 VerticalAlignment="Center" />

                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  AutomationProperties.Name="Time unit"
                                  ItemsSource="{Binding TimeSimulation.AvailableUnits}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding TimeSimulation.Unit}"
                                  Width="90"
                                  FontSize="14"
                                  Margin="6, 0, 0, 0" />

                        <Button Style="{StaticResource StatusCardActionButton}"
                                Content="Fast-forward"
                                Margin="6, 0, 0, 0"
                                Width="100"
                                Padding="6"
                                Command="{Binding TimeSimulation.FastForwardCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </views:RegionGrid>
    </Grid>
</Window>
