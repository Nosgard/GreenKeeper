<Window x:Class="GreenKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenKeeper"
        xmlns:views="clr-namespace:GreenKeeper.Views"
        mc:Ignorable="d"
        Icon="{StaticResource AppIcon}"
        Title="GreenKeeper"
        MinHeight="{StaticResource WindowMinHeight}"
        MinWidth="{StaticResource WindowMinWidth}"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <!-- Width and Height above are the design size: the UI is drawn at scale 1 there and
         scales from it at every other size (InitializeResponsiveSize in MainWindow.xaml.cs) -->

    <!-- Main Grid -->
    <Grid Background="{DynamicResource WindowBackground}">
        <!-- Sidebar and dashboard share the width in the proportion of the design size
             (250 : 634 of the 884 px inside the window frame), the sidebar within its
             limits. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250*"
                              MinWidth="{StaticResource SidebarMinWidth}"
                              MaxWidth="{StaticResource SidebarMaxWidth}" />
            <ColumnDefinition Width="634*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar. F6 and Shift+F6 switch between it and the dashboard (FocusRegions).
             The name tells a screen reader which of the two it is in. -->
        <views:RegionGrid x:Name="Sidebar"
                          AutomationProperties.Name="Sidebar"
                          AutomationProperties.AcceleratorKey="F6"
                          Background="{DynamicResource SidebarBackground}"
                          Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16, 20, 16, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Heading of the plant list, one step smaller than the plant name in the
                     dashboard, the main title. The top margin puts both on one baseline. -->
                <TextBlock Grid.Column="0"
                           AutomationProperties.HeadingLevel="Level1"
                           Text="My Plants"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0, 4, 0, 0" />

                <!-- Theme toggle. It shows only an icon, so its label is the name a screen
                     reader announces and the text of its tooltip. AccessibleName instead of
                     AutomationProperties.Name, because the label changes with every click and
                     WPF would not report that. The top margin centers the icon on the capital
                     letters of the heading, about 22 below the top of the row, and makes the
                     row 38 high, which keeps the edges of the search box below sharp. -->
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        views:AccessibleName.Text="{Binding Theme.ToggleLabel}"
                        ToolTip="{Binding Theme.ToggleLabel}"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        Padding="4"
                        Margin="0, 6, 0, 0"
                        Command="{Binding Theme.ToggleCommand}">
                    <!-- The PNG supplies only the shape (its alpha channel), the color comes
                         from PrimaryText - so the icon fades along on a theme change.
                         24 = the button's 32 minus its padding. -->
                    <Rectangle Width="24"
                               Height="24"
                               Fill="{DynamicResource PrimaryText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="{Binding Theme.IsDarkTheme, Converter={StaticResource ThemeToggleIconConverter}}"
                                        Stretch="Uniform" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </Grid>

            <!-- Search bar -->
            <Border Grid.Row="1"
                    Margin="10, 10, 10, 10"
                    Background="{DynamicResource SearchBarBackground}"
                    BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="1"
                             x:Name="SearchTextBox"
                             AutomationProperties.Name="Search plants"
                             FocusVisualStyle="{StaticResource FocusRing}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource SearchText}"
                             CaretBrush="{DynamicResource SearchText}"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="10, 8, 10, 8" />
                    <TextBlock Grid.Column="1"
                               Text="Search..."
                               Foreground="{DynamicResource MutedText}"
                               FontSize="14"
                               Margin="10, 0, 0, 0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchTextBox}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- List of plants -->
            <ListView Grid.Row="2"
                      x:Name="PlantList"
                      AutomationProperties.Name="Plants"
                      FocusVisualStyle="{StaticResource FocusRing}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="6, 0, 6, 0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding Plants}"
                      SelectedItem="{Binding SelectedPlant, Mode=TwoWay}"
                      SelectionChanged="PlantList_SelectionChanged">
                <ListView.Resources>
                    <!-- Context menu of a plant entry. It sits on the entry rather than on its
                         content, so the keyboard opens it too (menu key, Shift+F10): WPF looks for a
                         context menu on the focused element and its ancestors. One menu per entry,
                         so it is not shared. -->
                    <ContextMenu x:Key="PlantContextMenu"
                                 x:Shared="False"
                                 Style="{StaticResource ThemedContextMenu}">
                        <MenuItem Header="Rename..."
                                  Style="{StaticResource ThemedMenuItem}"
                                  Command="{Binding PlacementTarget.Tag.RenamePlantCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </ListView.Resources>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <!-- A screen reader announces the entry by its name and the state of its
                             status dot: "Aloe Vera, overdue". AccessibleName instead of
                             AutomationProperties.Name, because the state changes while the entry is
                             in use and WPF would not report that. -->
                        <Setter Property="views:AccessibleName.Text" Value="{Binding Converter={StaticResource PlantAccessibleNameConverter}}" />
                        <EventSetter Event="KeyDown" Handler="PlantEntry_KeyDown" />
                        <!-- The context menu opens in a popup outside the window's tree: it
                             reaches the window's ViewModel through PlacementTarget.Tag -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource PlantContextMenu}" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="itemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            Margin="0, 2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedBackground}" />
                                            <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- Template for plant entries -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Status dot. Its state is part of the entry's name, so a
                                 screen reader skips the dot itself. -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{Binding Converter={StaticResource PlantStatusDotConverter}}"
                                              ContentTemplate="{StaticResource PlantStatusDot}"
                                              VerticalAlignment="Center"
                                              Margin="0, 0, 4, 0" />

                            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       Foreground="{DynamicResource PrimaryText}"
                       FontSize="24"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="0, -1.5, 0, 1.5"
                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Says why the list is empty. The text is set in the style, because a text
                 set on the element would win over the trigger that changes it. -->
            <TextBlock Grid.Row="2"
                       Foreground="{DynamicResource SecondaryText}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="16, 8, 16, 0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- A search found no plant, in the words a screen reader hears -->
                        <Setter Property="Text" Value="No plants found" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=PlantList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Without a search, the list is empty because no plant was added yet -->
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Text" Value="No plants yet" />
                            </DataTrigger>
                            <!-- At every start the list is empty for a moment, until the plants are loaded -->
                            <DataTrigger Binding="{Binding HasLoadedPlants}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Add button -->
            <Button Grid.Row="3"
                    Style="{StaticResource BigButton}"
                    Margin="10, 8, 10, 12"
                    Padding="0, 10"
                    Content="+  Add Plant"
                    AutomationProperties.Name="Add Plant"
                    Command="{Binding AddPlantCommand}"/>
        </views:RegionGrid>

        <!-- Dashboard -->
        <views:RegionGrid x:Name="Dashboard"
                          AutomationProperties.Name="Dashboard"
                          AutomationProperties.AcceleratorKey="F6"
                          Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Navigation -->
            <Grid Grid.Row="0"
                  VerticalAlignment="Center"
                  Margin="16, 20, 16, 12"
                  MaxWidth="{StaticResource ContentMaxWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           AutomationProperties.HeadingLevel="Level2"
                           VerticalAlignment="Top"
                           Text="{Binding SelectedPlant.Name}"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectedPlant.Name}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}"
                            Content="+  Add Schedule"
                            AutomationProperties.Name="Add Schedule"
                            Command="{Binding AddScheduleCommand}" />

                    <Button Style="{StaticResource DialogButton}"
                            Margin="10, 0, 0, 0"
                            Content="-  Delete Plant"
                            AutomationProperties.Name="Delete Plant"
                            Command="{Binding DeletePlantCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" />

            <!-- Status: scrolls as soon as the cards do not fit above the footer -->
            <ScrollViewer x:Name="StatusScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <StackPanel x:Name="StatusPanel"
                            Margin="16, 0, 16, 12"
                            MaxWidth="{StaticResource ContentMaxWidth}"
                            RequestBringIntoView="StatusPanel_RequestBringIntoView">
                    <TextBlock x:Name="StatusHeading"
                               AutomationProperties.HeadingLevel="Level3"
                               Text="Status"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Visibility="{Binding IsPlantSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Status Cards (Watering, Fertilizing, Sunlight) -->
                    <ItemsControl x:Name="CareStatusList"
                                  ItemsSource="{Binding CareStatuses}"
                                  ItemTemplate="{StaticResource CareStatusCardTemplate}"
                                  ItemContainerStyle="{StaticResource CareStatusCardContainer}"
                                  AutomationProperties.Name="{Binding Text, ElementName=StatusHeading}"
                                  Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Shown while no plant is selected, so the empty dashboard says what to do.
                 F6 reads it out as well. The text is set in the style, because a text set
                 on the element would win over the trigger that changes it. -->
            <TextBlock x:Name="EmptyDashboardHint"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedText}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16, 0, 16, 0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Select a plant or add a new one" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlantSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Nothing to select yet. Only once the plants are loaded, since the list is
                                 empty for a moment at every start -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Plants.Count}" Value="0" />
                                    <Condition Binding="{Binding HasLoadedPlants}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="Add your first plant to get started" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Footer: stays in view below the cards -->
            <Grid Grid.Row="3"
                  Margin="16, 0, 16, 0"
                  MaxWidth="{StaticResource ContentMaxWidth}">
                <!-- Notes button -->
                <Button Style="{StaticResource DialogButton}"
                        Content="View Notes"
                        Margin="0, 0, 0, 16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenNotesCommand}"/>

                <!-- Debug section -->
                <Border Background="{DynamicResource DangerBackground}"
                        BorderBrush="{DynamicResource DangerBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0, 0, 0, 80"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SimulateLabel"
                                   Text="DEBUG: Simulate"
                                   Foreground="{DynamicResource DangerForeground}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0, 0, 8, 0" />

                        <TextBox Style="{StaticResource ThemedTextBox}"
                                 AutomationProperties.Name="{Binding Text, ElementName=SimulateLabel}"
                                 Text="{Binding TimeSimulation.AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="40"
                                 Padding="4"
                                 FontSize="12"
                                 VerticalAlignment="Center" />

                        <ComboBox Style="{StaticResource ThemedComboBox}"
                                  AutomationProperties.Name="Time unit"
                                  ItemsSource="{Binding TimeSimulation.AvailableUnits}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding TimeSimulation.Unit}"
                                  Width="90"
                                  Margin="6, 0, 0, 0" />

                        <Button Style="{StaticResource StatusCardActionButton}"
                                Content="Fast-forward"
                                Margin="6, 0, 0, 0"
                                Width="100"
                                Padding="6"
                                Command="{Binding TimeSimulation.FastForwardCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </views:RegionGrid>
    </Grid>
</Window>
